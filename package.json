{
  "name": "openapi-flow-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspace @openapi-flow/core",
    "typecheck": "npm run typecheck --workspace @openapi-flow/core",
    "lint": "npm run lint --workspace @openapi-flow/core",
    "format:check": "npm run format:check --workspace @openapi-flow/core",
    "format": "npm run format --workspace @openapi-flow/core",
    "test": "npm run test --workspace @openapi-flow/core",
    "test:real-oas": "npm run test:real-oas --workspace @openapi-flow/core",
    "test:local-n8n": "npm run test:local-n8n --workspace @openapi-flow/core",
    "eval:selection": "npm run eval:selection --workspace @openapi-flow/core"
  },
  "devDependencies": {
    "zod": "4.6.5"
  }
}
