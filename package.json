{
  "name": "openapi-flow-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/langchain",
    "packages/n8n",
    "examples/langgraph-workflow"
  ],
  "scripts": {
    "graph:update": "npm run build && node scripts/update-workflow-conversation-graph.mjs",
    "graph:check": "node scripts/update-workflow-conversation-graph.mjs --check",
    "build": "node scripts/clean-build.mjs && npm run build --workspace @openapi-flow/core && npm run build --workspace @openapi-flow/langchain && npm run build --workspace @openapi-flow/n8n && npm run build --workspace @openapi-flow/example-langgraph-workflow && tsc -p examples/legacy-generation/tsconfig.json",
    "typecheck": "npm run build && npm run typecheck --workspaces",
    "lint": "eslint packages/*/src test integration examples/*/src scripts/release/*.mjs scripts/verify-release-candidate.mjs scripts/update-workflow-conversation-graph.mjs",
    "format:check": "prettier --check packages/*/src test integration examples/*/src examples/langgraph-workflow/{package.json,tsconfig.json,README.md,specs,evaluation} package.json packages/*/package.json packages/*/tsconfig.json eslint.config.mjs scripts/release/*.mjs scripts/verify-release-candidate.mjs scripts/update-workflow-conversation-graph.mjs",
    "format": "prettier --write packages/*/src test integration examples/*/src examples/langgraph-workflow/{package.json,tsconfig.json,README.md,specs,evaluation} package.json packages/*/package.json packages/*/tsconfig.json eslint.config.mjs scripts/release/*.mjs scripts/verify-release-candidate.mjs scripts/update-workflow-conversation-graph.mjs",
    "test": "npm run build && node --test test/legacy/*.test.mjs test/*.test.mjs",
    "test:real-oas": "npm run build && node --test integration/real-oas.mjs",
    "test:packed-consumer": "npm run build && node integration/packed-consumer-smoke.mjs",
    "test:local-n8n": "npm run build && node integration/local-n8n-smoke.mjs",
    "test:request-bindings-local-n8n": "npm run build && node integration/request-bindings-local-n8n.mjs",
    "test:native-runtime-input-local-n8n": "npm run build && node integration/native-runtime-input-local-n8n.mjs",
    "test:draft-edit-local-n8n": "npm run build && node integration/workflow-draft-edit-local-n8n.mjs",
    "test:native-material-revision-local-n8n": "npm run build && node integration/native-material-revision-local-n8n.mjs",
    "test:native-node-addition-local-n8n": "npm run build && node integration/native-node-addition-local-n8n.mjs",
    "test:api-call-planning-local-n8n": "npm run build && node integration/api-call-planning-local-n8n.mjs",
    "test:draft-conversation-local-n8n": "npm run build && node integration/workflow-draft-conversation-local-n8n.mjs",
    "test:api-response-sources-local-n8n": "npm run build && node integration/api-response-sources-local-n8n.mjs",
    "test:draft-clarification-local-n8n": "npm run build && node integration/draft-clarification-local-n8n.mjs",
    "test:review-suggestions-local-n8n": "npm run build && node integration/draft-clarification-local-n8n.mjs --with-follow-up",
    "test:clarification-answer-revision-local-n8n": "npm run build && node integration/draft-clarification-local-n8n.mjs --with-answer-revision",
    "test:api-binding-questions-local-n8n": "npm run build && node integration/draft-clarification-local-n8n.mjs --with-binding-answer",
    "test:native-feature-planning-local-n8n": "npm run build && node integration/native-feature-planning-local-n8n.mjs",
    "test:native-singleton-responses-local-n8n": "npm run build && node integration/native-singleton-responses-local-n8n.mjs",
    "test:api-response-object-local-n8n": "npm run build && node integration/api-response-object-local-n8n.mjs",
    "test:api-response-results-local-n8n": "npm run build && node integration/api-response-results-local-n8n.mjs",
    "test:requirement-history-local-n8n": "npm run build && node integration/requirement-history-local-n8n.mjs",
    "test:requirement-scope-local-n8n": "npm run build && node integration/requirement-scope-local-n8n.mjs",
    "test:clarification-ownership-local-n8n": "npm run build && node integration/clarification-ownership-local-n8n.mjs",
    "test:array-iteration-local-n8n": "npm run build && node integration/array-iteration-local-n8n.mjs",
    "test:native-array-iteration-local-n8n": "npm run build && node integration/native-array-iteration-local-n8n.mjs",
    "test:native-schema-references": "npm run build && node integration/native-schema-reference-repro.mjs",
    "test:nested-array-iteration-local-n8n": "npm run build && node integration/nested-array-iteration-local-n8n.mjs",
    "test:batch-iteration-local-n8n": "npm run build && node integration/batch-iteration-local-n8n.mjs",
    "test:conditional-batch-local-n8n": "npm run build && node integration/batch-iteration-local-n8n.mjs --conditional",
    "test:item-join-local-n8n": "npm run build && node integration/item-join-local-n8n.mjs",
    "test:batch-item-join-local-n8n": "npm run build && node integration/item-join-local-n8n.mjs --batch",
    "test:schema-projection-local-n8n": "npm run build && node integration/schema-projection-local-n8n.mjs",
    "test:json-response-local-n8n": "npm run build && node integration/json-response-local-n8n.mjs",
    "test:http-response-decoding-local-n8n": "npm run build && node integration/http-response-decoding-local-n8n.mjs",
    "test:http-authentication-local-n8n": "npm run build && node integration/http-authentication-local-n8n.mjs",
    "test:native-output-bindings-local-n8n": "npm run build && node integration/native-output-bindings-local-n8n.mjs",
    "test:orchestration-local-n8n": "npm run build && node integration/native-output-bindings-local-n8n.mjs --orchestrated",
    "test:deployment-template-local-n8n": "npm run build && node integration/deployment-template-local-n8n.mjs",
    "test:workflow-review-local-n8n": "npm run build && node integration/workflow-review-local-n8n.mjs",
    "test:requested-api-inputs-local-n8n": "npm run build && node integration/requested-api-inputs-local-n8n.mjs",
    "test:capability-gaps-local-n8n": "npm run build && node integration/capability-gaps-local-n8n.mjs",
    "test:live-model-local-n8n": "npm run build && node integration/live-model-local-n8n.mjs",
    "eval:selection": "npm run build && node examples/langgraph-workflow/dist/cli/evaluate-api-selection.js",
    "eval:selection:legacy": "npm run build && node integration/evaluate-operation-selection.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@langchain/core": "1.2.12",
    "@langchain/openai": "^1.5.13",
    "@n8n/workflow-sdk": "0.36.4",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "zod": "4.6.7"
  }
}
