{
  "name": "@openapi-flow/core",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Engine-independent OpenAPI catalogs, operation contracts and typed request schemas",
  "keywords": [
    "openapi",
    "n8n",
    "workflow",
    "langchain"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carefreelife98/openapi-flow.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/carefreelife98/openapi-flow#readme",
  "bugs": "https://github.com/carefreelife98/openapi-flow/issues",
  "author": "carefreelife98",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/public-api.d.ts",
      "default": "./dist/public-api.js"
    },
    "./internal": {
      "types": "./dist/internal-api.d.ts",
      "default": "./dist/internal-api.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@scalar/json-schema-validator": "^0.1.6",
    "@scalar/openapi-parser": "0.29.7",
    "@scalar/openapi-types": "0.9.7",
    "@scalar/openapi-validator": "0.1.6",
    "zod": "4.6.5"
  }
}
