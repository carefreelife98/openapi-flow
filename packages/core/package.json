{
  "name": "@openapi-flow/core",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Build reviewable n8n workflows from OpenAPI documents and natural-language scenarios",
  "keywords": [
    "openapi",
    "n8n",
    "workflow",
    "langchain"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carefreelife98/openapi-flow.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/carefreelife98/openapi-flow#readme",
  "bugs": "https://github.com/carefreelife98/openapi-flow/issues",
  "author": "carefreelife98",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/public-api.d.ts",
      "default": "./dist/public-api.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test integration",
    "format:check": "prettier --check src test integration package.json tsconfig.json eslint.config.mjs",
    "format": "prettier --write src test integration package.json tsconfig.json eslint.config.mjs",
    "test": "npm run build && node --test",
    "test:real-oas": "npm run build && node --test integration/real-oas.mjs",
    "eval:selection": "npm run build && node integration/evaluate-operation-selection.mjs"
  },
  "dependencies": {
    "@n8n/workflow-sdk": "0.33.1",
    "@scalar/json-schema-validator": "^0.1.6",
    "@scalar/openapi-parser": "0.29.7",
    "@scalar/openapi-validator": "0.1.6"
  },
  "peerDependencies": {
    "@langchain/core": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@langchain/core": "1.2.12",
    "@langchain/openai": "^1.5.13",
    "@types/node": "^24.0.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
