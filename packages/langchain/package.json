{
  "name": "@openapi-flow/langchain",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "description": "Composable LangChain planning for OpenAPI workflows",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/public-api.d.ts",
      "default": "./dist/public-api.js"
    },
    "./legacy": {
      "types": "./dist/legacy-api.d.ts",
      "default": "./dist/legacy-api.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@openapi-flow/core": "0.2.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@langchain/core": "^1.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carefreelife98/openapi-flow.git",
    "directory": "packages/langchain"
  }
}
