{
  "name": "@openapi-flow/n8n",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "description": "Deterministic OpenAPI request nodes and n8n workflow assembly",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/public-api.d.ts",
      "default": "./dist/public-api.js"
    },
    "./legacy": {
      "types": "./dist/legacy-api.d.ts",
      "default": "./dist/legacy-api.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/build-request-runtime.mjs && node ../../scripts/build-item-join-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@n8n/workflow-sdk": "0.33.1",
    "@openapi-flow/core": "0.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "zod": "4.6.5"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carefreelife98/openapi-flow.git",
    "directory": "packages/n8n"
  }
}
